{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "existingSecret",
    "image",
    "replicaCount",
    "publicUrl"
  ],
  "properties": {
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "development"
      ]
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "providerTimeoutSeconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 600
    },
    "circuitBreaker": {
      "type": "object",
      "required": [
        "enabled",
        "failureThreshold",
        "cooldownSeconds",
        "probeSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cooldownSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "probeSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1800
        }
      }
    },
    "maintenance": {
      "type": "object",
      "required": [
        "enabled",
        "suspend",
        "schedule",
        "resources",
        "batchSize",
        "startingDeadlineSeconds",
        "activeDeadlineSeconds",
        "backoffLimit",
        "successfulJobsHistoryLimit",
        "failedJobsHistoryLimit",
        "ttlSecondsAfterFinished"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "suspend": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 9,
          "maxLength": 120,
          "pattern": "^\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+$"
        },
        "resources": {
          "type": "object"
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "startingDeadlineSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 86400
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "poolSize",
        "maxOverflow",
        "poolTimeoutSeconds",
        "poolRecycleSeconds",
        "statementTimeoutMs",
        "lockTimeoutMs",
        "migrationStatementTimeoutMs",
        "migrationLockTimeoutMs"
      ],
      "properties": {
        "poolSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxOverflow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "poolTimeoutSeconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 120
        },
        "poolRecycleSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "statementTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "lockTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "migrationStatementTimeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "migrationLockTimeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      }
    },
    "guardrails": {
      "type": "object",
      "required": [
        "enabled",
        "action",
        "detectors",
        "maxCharacters"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "action": {
          "type": "string",
          "enum": [
            "block",
            "redact"
          ]
        },
        "detectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "secrets",
              "private_key",
              "email",
              "us_ssn",
              "payment_card"
            ]
          }
        },
        "maxCharacters": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      }
    },
    "enrollment": {
      "type": "object",
      "required": [
        "enabled",
        "allowedModels",
        "keyDays",
        "rpm",
        "tpm",
        "maxPending"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedModels": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "keyDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "rpm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "tpm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maxPending": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "allowedModels": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
