[Unit]
Description=Brrrtgate explicit database migration (operator initiated)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=brrrtgate
Group=brrrtgate
WorkingDirectory=/opt/brrrtgate/current
EnvironmentFile=/etc/brrrtgate/gateway.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
ExecStart=/opt/brrrtgate/current/.venv/bin/python -m gateway.migrate
TimeoutStartSec=900
TimeoutStopSec=30
