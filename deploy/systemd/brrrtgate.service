[Unit]
Description=Brrrtgate LLM gateway
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=brrrtgate
Group=brrrtgate
WorkingDirectory=/opt/brrrtgate/current
EnvironmentFile=/etc/brrrtgate/gateway.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
ExecStart=/opt/brrrtgate/current/.venv/bin/python -m gateway.cli --host 127.0.0.1 --port 8080 --shutdown-grace-seconds 360
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=420

[Install]
WantedBy=multi-user.target
