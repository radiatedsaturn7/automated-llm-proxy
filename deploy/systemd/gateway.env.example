# Non-secret configuration only. Replace public URL; provide files separately.
ENVIRONMENT=production
PUBLIC_URL=https://gateway.example.invalid
GATEWAY_SECRETS_DIR=/etc/brrrtgate/secrets
DATABASE_URL_FILE=/etc/brrrtgate/secrets/database-url
GATEWAY_MASTER_KEY_FILE=/etc/brrrtgate/secrets/master-key
GATEWAY_SIGNING_KEY_FILE=/etc/brrrtgate/secrets/signing-key
BOOTSTRAP_TOKEN_FILE=/etc/brrrtgate/secrets/bootstrap-token
METRICS_TOKEN_FILE=/etc/brrrtgate/secrets/metrics-token
# Optional OIDC: configure issuer/client ID/group mapping before enabling login.
# OIDC_CLIENT_SECRET_FILE=/etc/brrrtgate/secrets/oidc-client-secret
# Optional during planned offline key rotation only:
# GATEWAY_MASTER_DECRYPT_KEYS_FILE=/etc/brrrtgate/secrets/master-decrypt-keys
DB_MIGRATION_STATEMENT_TIMEOUT_MS=600000
DB_MIGRATION_LOCK_TIMEOUT_MS=60000
MAX_INFLIGHT_REQUESTS=128
MAX_INFLIGHT_OPERATIONS=8
